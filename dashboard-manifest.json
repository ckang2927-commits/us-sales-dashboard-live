      "originalSha256": "6e271046d479c51baa3134e8e5240e1e725e18ac5a433314cb365379697bbb66",
      "replacement": "function npRenderNews(){const host=cxEl('cxNewsBody');if(!host)return;const previous=typeof biCaptureMotion==='function'?biCaptureMotion(host):null;const all=npMergedRows(),n=cxState.news,rows=npFilteredRows(),counts={},stages={};for(const row of all){counts[row.coverage]=(counts[row.coverage]||0)+1;const stage=row.developmentStatus||'待核';stages[stage]=(stages[stage]||0)+1;}const stageNames=Object.keys(stages).sort((a,b)=>stages[b]-stages[a]),max=Math.max(1,...Object.values(stages));const positive=all.filter(row=>npIsPositive(row.np)).length,pending=all.filter(row=>row.np.status==='待核').length,held=all.filter(row=>row.np.status==='暂缓复购').length;let html='<section class=\"cx-cat np-newproducts\" aria-label=\"新品拟定补货历史快照\"><p class=\"cx-cat-note\">新品／改款候选 '+all.length+' 项。历史方案参考销量至美西 '+npEsc(npData.meta.salesCutoff)+'；方案库存主表读取 '+npEsc(npData.meta.stockReadDate)+'；开发状态沿11/11原快照。</p><div class=\"np-summary-bar\">'+npChip('拟定补货','positive',positive,npState.status==='positive','status')+npChip('数量待核','pending',pending,npState.status==='pending','status')+npChip('暂缓复购','held',held,npState.status==='held','status')+'<span>7个月：'+npEsc(npData.meta.start)+'—'+npEsc(npData.meta.end)+' · '+npQty(npData.meta.days)+'天</span></div><div class=\"cx-cat-coverage\" aria-label=\"原计划覆盖，点击筛选再点取消\">'+npCoverageOrder.map(key=>npChip(npCoverageLabels[key],key,counts[key]||0,n.coverage===key,'coverage')).join('')+'</div><div class=\"cx-cat-stage-heading\">开发状态 · '+all.length+' 项<span>点横条常亮筛选，再点取消</span></div><div class=\"cx-cat-stage-chart np-stage-chart '+(n.stage?'has-selection':'')+'\" aria-label=\"原开发状态分布\">'+stageNames.map(stage=>'<button class=\"cx-cat-stage '+(n.stage===stage?'is-active':n.stage?'is-muted':'')+'\" data-cxcat-action=\"stage\" data-np-action=\"stage\" data-value=\"'+npEsc(stage)+'\" aria-pressed=\"'+(n.stage===stage)+'\"><span>'+npEsc(stage)+'</span><span class=\"cx-cat-stage-track\"><span class=\"cx-bar-fill\" style=\"width:'+(100*stages[stage]/max).toFixed(2)+'%\"></span></span><strong>'+stages[stage]+'</strong></button>').join('')+'</div><div class=\"cx-cat-toolbar\"><label>搜索SKU／产品<input type=\"search\" data-cxcat-field=\"news.search\" data-np-field=\"search\" value=\"'+npEsc(n.search)+'\" placeholder=\"输入SKU、产品或工厂\"></label><label>开发状态<select data-cxcat-field=\"news.stage\" data-np-field=\"stage\"><option value=\"\">全部开发状态</option>'+Object.keys(stages).sort().map(stage=>'<option value=\"'+npEsc(stage)+'\" '+(stage===n.stage?'selected':'')+'>'+npEsc(stage)+'</option>').join('')+'</select></label>'+npSortControls()+'<button class=\"cx-cat-clear\" data-cxcat-action=\"clear-news\" data-np-action=\"clear\">清除筛选</button><button class=\"cx-cat-export\" data-cxcat-action=\"export-news\" data-np-action=\"export\">导出当前清单</button></div><div class=\"cx-cat-result\">当前 '+rows.length+' / '+all.length+' 项<span>状态保留销量参考；原11/8已核净量单独在SKU详情保留</span></div><p class=\"np-sort-note\">表头可排序，组合列点⌄选择单项；区间按上界，待核始终置后。YQN排序采用原库龄快照，与11/12可用库存分开。</p>';"
    },
