      "replacement": "function npExport(){const rows=npFilteredRows();cxDownloadCsv('新品_拟定补货历史快照_20261112.csv',['SKU','产品类别','开发状态','开发读取日','原覆盖','方案快照可用','方案快照预留','方案快照在途','方案库存读取日','YQN历史库龄原值','YQN历史库龄源日期','方案参考销量截止','30天状态保留下界','30天状态保留上界','60天状态保留下界','60天状态保留上界','采用窗口天','日销下界','日销上界','目标开始','目标结束','目标天数','原年底计划P','同源已登记未履约E','原计划尚未落实余量','其他去重未来供给','未闭环采购余额','未来供给下界','未来供给上界','7个月需求下界','7个月需求上界','拟定滚动补货下界','拟定滚动补货上界','测算状态','限制','原滚动参考','原公司计划参考','ETA说明','备注'],rows.map(original=>{const r=original.np;return [r.sku,original.category,original.developmentStatus,original.developmentDate,npCoverageLabels[original.coverage],r.available,r.reserved,r.transit,npData.meta.stockReadDate,npFrozenStock.get(r.sku)?.age,npFrozenStock.get(r.sku)?.ageDate,npData.meta.salesCutoff,r.sales30Lower,r.sales30Upper,r.sales60Lower,r.sales60Upper,r.adoptedWindow,r.dailyLower,r.dailyUpper,npData.meta.start,npData.meta.end,npData.meta.days,r.yearendPlan,r.yearendExecutedOutstanding,r.yearendUnexecuted,r.otherFuture,r.unclosedProcurement,r.futureLower,r.futureUpper,r.demand7Lower,r.demand7Upper,r.proposedLower,r.proposedUpper,r.status,r.restriction,r.oldRollingReference,original.companyPlanQuantity,npEtaSummary(r),(r.notes||[]).join('；')];}));}"
