      "originalSha256": "7b8fa38c6be5046551cccd1e5731b1e981530ec844501d443b03c45253e7005d",
      "replacement": "// 原补货方案及11/8净量来自首个原始快照，后续刷新只更新当前数据。\nconst npFrozenStock = new Map(npData.rows.map(({sku}) => {\n const row = cxStock(sku) || {};\n return [sku, {net30_lower:row.net30_lower, net30_upper:row.net30_upper,\n  net60_lower:row.net60_lower, net60_upper:row.net60_upper,\n  age:row.age, ageDate:row.ageDate, ageBands:{...row.ageBands},\n  known:{yqn_age_row_present:row.known?.yqn_age_row_present}}];\n}));\nconst npOldNet = (sku, days) => {\n const row = npFrozenStock.get(sku) || {};\n const lower = row['net'+days+'_lower'], upper = row['net'+days+'_upper'];\n return cxNum(lower) || cxNum(upper) ? npRange(lower, upper) : '待核';\n};"
    },
    {
