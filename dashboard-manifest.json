      "originalSha256": "7c49da0dfc858784dacc97d003315e9f91baf164736e38fa10741fa7cb4d86a4",
      "replacement": "function npLatestDetail(row){const original=npOriginalMap.get(row.sku)||{};return '<section class=\"np-latest-detail\"><h3>历史拟定补货方案</h3><p class=\"cx-caption\">参考销量至美西 '+npEsc(npData.meta.salesCutoff)+'；方案库存读取 '+npEsc(npData.meta.stockReadDate)+'。覆盖 '+npEsc(npData.meta.start)+'—'+npEsc(npData.meta.end)+'，'+npQty(npData.meta.days)+'天。</p>'+cxTable(['项目','当前采用值','说明'],[['方案近30天保留销量',npRange(row.sales30Lower,row.sales30Upper),'10/12—11/10，含待核上下界'],['方案近60天保留销量',npRange(row.sales60Lower,row.sales60Upper),'9/12—11/10，含待核上下界'],['采用销速窗口',npQty(row.adoptedWindow)+'天','30天有保留销量优先30天；未完成断货日还原'],['采用日销',npRange(row.dailyLower,row.dailyUpper),'状态保留参考套／日'],['7个月需求',npRange(row.demand7Lower,row.demand7Upper),'沿本次模型的212天测算'],['方案快照可用库存',npQty(row.available),'预留不作为额外可用；已到仓不在未来供给重复计入'],['去重未来供给',npRange(row.futureLower,row.futureUpper),'原计划、登记和在途按同源抵扣'],['拟定滚动补货', '<strong>'+npRange(row.proposedLower,row.proposedUpper)+'</strong>',npEsc(row.status)+(row.restriction?'；'+npEsc(row.restriction):'')],['旧滚动参考',npQty(row.oldRollingReference),'旧建议只供对照，不作本轮未来供给'],['原公司计划参考',npQty(original.companyPlanQuantity),'原版本独立保存，不与原年底P重复抵扣']])+'<p class=\"np-warning\">'+npEsc(row.restriction||npData.meta.quantityMeaning)+'</p>'+(row.notes?.length?'<p class=\"cx-caption\">'+npEsc(row.notes.join('；'))+'</p>':'')+'<details class=\"cx-fold\"><summary>未来供给与到仓证据</summary><div class=\"cx-fold-body\">'+npSupplyDetail(row)+'<details class=\"np-evidence\"><summary>展开采购原行</summary>'+cxTable(['来源','原SKU','数量','下单日期','预计出货','供应商／合同'],(row.futureEvidence||[]).map(e=>{const fields=e.fields||{};return [npSourceEvidence(e),npEsc(e.sku||row.sku),npQty(fields['数量']),npEsc(fields['下单日期']||'未填'),npEsc(fields['预计出货时间']||'未填'),npEsc(fields['供应商/商铺名\\n']||fields['供应商/商铺名']||fields['合同抬头']||'未填')];}))+'</details></div></details><details class=\"cx-fold\"><summary>原方案订单依据 · 至11/10</summary><div class=\"cx-fold-body np-orders-slot\" data-np-orders=\"'+npEsc(row.sku)+'\">'+npOrdersDetail(row.sku)+'</div></details><details class=\"cx-fold\"><summary>旧看板已核净销量与原日期</summary><div class=\"cx-fold-body\">'+cxTable(['项目','旧快照值','日期'],[['近30天已核净套',npOldNet(row.sku,30),'美西截至11/8'],['近60天已核净套',npOldNet(row.sku,60),'美西截至11/8'],['YQN库龄',npEsc(npFrozenStock.get(row.sku)?.age||'待核'),npEsc(npFrozenStock.get(row.sku)?.ageDate||'原快照日期待核')],['原首次实际到仓',npEsc(original.firstDate||'待核'),npEsc(original.firstDateKind||'不等于正式首次可售')]])+'<p class=\"cx-caption\">新参考销量与旧已核净量是两个来源，不能直接把窗口差额当成新增订单。</p></div></details><details class=\"np-evidence\"><summary>本次库存与销量来源</summary><p>'+npSourceEvidence(row.inventoryEvidence)+'</p><p>'+npSourceEvidence(row.salesEvidence)+'；原行 '+npEsc((row.salesEvidence?.exactSourceRows||[]).join('、'))+'</p><p>'+npEsc(row.stockDateBasis||'')+'</p></details></section>';}"
    },
